# custom: a deployment you describe when you start the run.
#
# Fill in the base_url, tenant_slug and digit_tenant inputs on the "Run
# workflow" form; they land on top of this file. Logins and passwords come from
# the repository secret SECRETS_CUSTOM (see secrets.example next to this file).
#
# There is no UPSTREAM_ENV: nothing is assumed about the deployment. The suite's
# profile-setup step discovers the rest (boundaries, complaint types, locales,
# personas) by reading the live deployment.

# The Keycloak realm. The suite falls back to the root tenant when it's unset.
# Uncomment if the deployment uses a shared realm, as naipepea does with `digit`.
# KC_REALM=digit

# Judge the run against the suite's conservative default expectations.
# (A deployment you run often deserves its own environment folder and
# expectations file: docs/GUIDE.md §5.)
EXPECTATIONS_FILE=deploy/expectations/default.json

# Persona discovery must not guess passwords: every guess against a Keycloak
# login is a failed sign-in, and Keycloak locks accounts after a few.
PERSONA_PASSWORD_GUESSES=
