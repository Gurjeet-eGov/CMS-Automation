# What goes in the repository secret SECRETS_CUSTOM: one KEY=value per line.
#
# The custom environment knows nothing about the deployment, so this block also
# carries the logins (Keycloak emails) the suite signs in with. Logins aren't
# secret, but keeping them with their passwords means one paste per deployment.
#
# Lines starting with # and blank lines are ignored. Values are taken
# literally: no quotes needed, and $ ` " ' are fine inside them.
ADMIN_USER=
ADMIN_PASSWORD=
EMPLOYEE_USER=
EMPLOYEE_PASSWORD=
GRO_USER=
GRO_PASSWORD=
WARD_CSR_USER=
WARD_CSR_PASSWORD=
# A Keycloak login with no roles; employee/login.spec.ts posts wrong passwords to it
LOGIN_PROBE_LOGIN=
# The deployment's fixed 6-digit citizen OTP (identity_dev_fixed_otp)
IDENTITY_TEST_OTP_CODE=
