# bomet: public config for runs against https://bometfeedbackhub.digit.org
#
# Public values only: this file is committed to a public repo. Passwords and
# the fixed OTP go in the repository secret SECRETS_BOMET (see secrets.example
# next to this file, and docs/GUIDE.md §2).
#
# How a run builds its settings (ci/load-env.sh), later lines winning:
#   1. UPSTREAM_ENV below: the suite's own profile for this deployment
#   2. the rest of this file
#   3. the base_url / tenant_slug / digit_tenant inputs, when you fill them in
#   4. the SECRETS_BOMET secret

# The suite's bomet profile: URL, tenant `ke`, expectations file, HRMS persona
# codes. It predates the Keycloak + Identity BFF sign-in the suite uses now.
UPSTREAM_ENV=deploy/bomet.env

# ── TODO before the first bomet run ──────────────────────────────────────────
# Staff now sign in through Keycloak and the Identity BFF, which needs the
# workspace slug (the path segment in https://<host>/<slug>/digit-ui/...).
# The suite's bomet profile doesn't set one, and it is not guessed here: a run
# stops at once with a plain message until this line has a value.
#
# If bomet does not run the new sign-in at all, a run of the current suite
# cannot log in there. In that case bomet needs an implementation branch
# (impl/bomet) carrying a suite version from before the change. See
# docs/GUIDE.md §4.
IDENTITY_TEST_TENANT_SLUG=

# With the new sign-in, *_USER values are Keycloak logins (emails), not the HRMS
# codes (HS_GRO, HS_SU) the old profile sets. Once you know bomet's logins, set
# them here (they are not secret):
# ADMIN_USER=
# EMPLOYEE_USER=
# GRO_USER=
# WARD_CSR_USER=
# LOGIN_PROBE_LOGIN=
# KC_REALM=
