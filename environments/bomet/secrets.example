# What goes in the repository secret SECRETS_BOMET: one KEY=value per line.
#
# Copy these lines, fill in the values, and paste the whole block as the
# secret's value (Settings → Secrets and variables → Actions → New repository
# secret). Never put the values in this file: it is committed and public.
#
# Lines starting with # and blank lines are ignored. Values are taken
# literally: no quotes needed, and $ ` " ' are fine inside them.
ADMIN_PASSWORD=
EMPLOYEE_PASSWORD=
GRO_PASSWORD=
WARD_CSR_PASSWORD=
CITY_ADMIN_PASS=
# The deployment's fixed 6-digit citizen OTP (identity_dev_fixed_otp)
IDENTITY_TEST_OTP_CODE=
# Optional: more personas the suite may sign in as, login:password pairs
# PERSONA_CANDIDATES=login:password,login:password
