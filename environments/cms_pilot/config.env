# cms_pilot: public config for runs of the 2.12.1 suite (branch digit-2.12.1-nairobi)
# against the CMS pilot deployment.
#
# Quote any value that contains spaces (KEY="a b c"): for local runs this file
# is sourced as shell, and an unquoted space ends the value.
#
# Public values only: this file is committed to a public repo. Logins, passwords
# and the fixed OTP go in secrets.env next to this file (git-ignored; copy
# secrets.example), or in the GitHub Environment's SECRETS_ENV secret.
#
# How a run builds its settings (ci/load-env.sh), later lines winning:
#   1. UPSTREAM_ENV, if set (none here: the suite ships no profile for this deployment)
#   2. this file
#   3. environments/cms_pilot/expectations.json → EXPECTATIONS_FILE
#   4. secrets.env / SECRETS_ENV
#
# Everything not set here (boundaries, complaint types, locales, personas, ID
# prefix, mobile and postal rules) is discovered from the live deployment by the
# suite's profile-setup step. Set a value only to override discovery, with a
# comment saying why.

# ── Target ─────────────────────────────────────────────────────────────────────
# The deployment's base URL, e.g. https://example.digit.org (no trailing slash).
BASE_URL=https://cms-pilot.digit.org

# The tenant complaints are filed in. A flat deployment uses its single tenant
# (e.g. ke); a two-level one uses the city (e.g. ke.nairobi).
DIGIT_TENANT=nb

# The state root tenant (e.g. ke). Admin logins and the configurator sign in here.
# Same as DIGIT_TENANT on a flat deployment. (TENANT_CODE is a deprecated alias.)
ROOT_TENANT=nb

# The tenant's name as the employee login page's City picker shows it, exactly
# (e.g. "Bomet County"). Discovered from localization when unset; set it if
# profile-setup warns that it fell back, because a wrong label makes every
# employee UI login wait 120 s and time out.
TENANT_LABEL="Nairobi City County"

# Shape of a complaint id on this deployment, as a regular expression. Unset =
# any upper-case letters, the year, then a sequence: ^[A-Z]+-\d{4}-\d+$
# (matches CMS-2026-000023 and CMS-2026-175). Set it for an implementation with
# another format, e.g. for NCCG-PGR-2026-04-13-000848. Keep the single quotes
# (for local runs this file is sourced as shell, which would eat the backslashes):
# COMPLAINT_ID_PATTERN='^[A-Z]+-PGR-\d{4}-\d{2}-\d{2}-\d+$'

# 1 only for a self-signed certificate.
# IGNORE_HTTPS_ERRORS=1

# ── Citizen OTP ────────────────────────────────────────────────────────────────
# Where citizen sign-in OTPs come from:
#   - OTP_SINK_URL set   → the suite reads each OTP from this SMS sink (a test-only
#                          endpoint that lists the SMS the deployment sent).
#   - OTP_SINK_URL unset → the suite uses FIXED_OTP from secrets.env (default 123456),
#                          for deployments that accept one fixed code.
# There is no fallback from a configured sink to the fixed code: a sink that
# returns nothing fails the sign-in with a plain message.
# OTP_SINK_URL=

# ── Session checks (@2.12_session_checks) — test environment only ──────────────
# Inactivity limit in seconds. Unset = the product default, 15 minutes, which is
# what production runs; delete this section for a production run. The
# "Stay signed in / Log out" pop-up always appears 60 s before the limit.
SESSION_IDLE_LIMIT_SECONDS=180

# ── Optional groups ────────────────────────────────────────────────────────────
# tests/onboarding/ walks the configurator onboarding wizard and creates and
# deactivates throwaway child tenants. Off unless set to 1.
# RUN_ONBOARDING=1

# Persona discovery may guess the stock password for HRMS employees no variable
# names (max 3 guesses each). Empty turns guessing off, so only the logins in
# secrets.env are tried; keep it empty on a shared deployment to avoid lockouts.
PERSONA_PASSWORD_GUESSES=
