# demo: public config template for one DIGIT 3.0 workspace.
#
# Copy this folder to environments/<name>/ (lowercase letters, digits and _
# only), fill in the values below, and put the logins, passwords and OTP
# settings in secrets.env next to it (copy secrets.example; secrets.env is
# git-ignored). See docs/GUIDE.md §2.
#
# Public values only: this file is committed to a public repo. Everything not
# set here (boundaries, complaint types, locales, personas) is discovered from
# the live deployment by the suite's profile-setup step.

# The deployment's base URL, e.g. https://example.digit.org
BASE_URL=

# The workspace slug: the /<slug>/digit-ui/ part of the URL.
IDENTITY_TEST_TENANT_SLUG=

# DIGIT_TENANT: copy it exactly as GET /identity/v1/tenant-contexts/<slug>
# returns it in "tenantId".
DIGIT_TENANT=

# TEMPORARY: true only while egovernments/complaint-management-system#84 is
# open on this workspace (the Identity BFF returns the tenant in upper case on
# Configurator sign-in, lower case elsewhere). true = compare tenant ids
# ignoring case, and store the Configurator session tenant lower-cased, as the
# Configurator UI does (tenantCaseWorkaround() in tests/utils/identity-bff.ts).
# Unset or false: off.
TENANT_CASE_WORKAROUND=

# Checks the UI's default language: the text the citizen header's language pill
# shows before anyone changes it, copied exactly as it appears on screen (for
# example English, or en). Not a locale code such as en_IN. Unset means "English".
CITIZEN_LANGUAGE_PILL_TEXT=

# The name a citizen gets on first OTP sign-in, exactly as the app stores it
# (for example Citizen on DIGIT 3.0). Unset means the phone number.
CITIZEN_DEFAULT_NAME=

# The complaint type seeded complaints use (lifecycle setup and seed helpers).
# It must belong to a department the GRO and LME personas have, or the GRO
# can't see the complaints it files. Unset: the suite picks one.
SERVICE_CODE=

# The Keycloak realm the tests/keycloak specs check.
KC_REALM=

# The deployment's SMS sink, for workspaces that send real, per-request citizen
# OTPs (no fixed code). Used when IDENTITY_TEST_OTP_CODE is empty, e.g.
# https://example.digit.org/sms-sink/messages
IDENTITY_TEST_OTP_SINK_URL=

# The expectations file the run is judged against, e.g.
# deploy/expectations/default.json
EXPECTATIONS_FILE=

# Persona discovery must not guess passwords: every guess against a Keycloak
# login is a failed sign-in, and Keycloak locks accounts after a few. Leave empty.
PERSONA_PASSWORD_GUESSES=
