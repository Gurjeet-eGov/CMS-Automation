# What goes in this environment's secrets: one KEY=value per line.
#
# Local runs: copy this file to secrets.env next to it (git-ignored) and fill in
# the values. GitHub Actions: paste the filled block as the repository secret
# SECRETS_<ENVIRONMENT> (Settings → Secrets and variables → Actions → New
# repository secret). Never put the values in this file: it is committed and public.
#
# The logins (Keycloak emails) live here with their passwords rather than in
# config.env, so test-account emails stay out of the public repo.
#
# Lines starting with # and blank lines are ignored. Values are taken
# literally: no quotes needed, and $ ` " ' are fine inside them.

# Workspace admin; needs a Configurator role (SUPERUSER, MDMS_ADMIN, …)
ADMIN_USER=
ADMIN_PASSWORD=
# The LME: the employee complaints get assigned to
EMPLOYEE_USER=
EMPLOYEE_PASSWORD=
# The GRO: assigns and rejects complaints
GRO_USER=
GRO_PASSWORD=
# A CSR limited to one ward (boundary jurisdiction tests)
WARD_CSR_USER=
WARD_CSR_PASSWORD=
# A Keycloak login with no roles; employee/login.spec.ts posts wrong passwords to it
LOGIN_PROBE_LOGIN=
# The deployment's fixed 6-digit citizen OTP; leave empty to read OTPs from
# IDENTITY_TEST_OTP_SINK_URL (config.env)
IDENTITY_TEST_OTP_CODE=
